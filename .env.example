# ============================================================
# 多语种UI文本格式检测系统 —— 环境变量
# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）
# ============================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ---------- LLM 接入（任意 OpenAI 兼容网关） ----------
# 必填：API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选：自定义网关地址。留空则使用 OpenAI 官方
#   Azure OpenAI / 阿里云百炼 / vLLM / One-API 等填各自兼容端点即可
# ⚠ 只填到 /v1 为止，**不要**带 /chat/completions —— SDK 会自己拼上去，
#   带上会请求到 .../chat/completions/chat/completions 而报 404。
#   正确： https://api.siliconflow.cn/v1      错误： https://api.siliconflow.cn/v1/chat/completions
OPENAI_BASE_URL=
# 多模态模型名。需具备视觉能力
LLM_MODEL=gpt-4o
# 图片视觉精度：high 对 OCR 与截断判定更准，但 Token 消耗更高
LLM_IMAGE_DETAIL=high
# 双图对比：把小语种截图与同行英文基准截图一起发给模型做视觉几何对照，
# 能显著提升截断/重叠的判别力，但小语种请求的 prompt token 近乎翻倍。
# 网关不支持多图输入时置 false 回退单图（可用 python tools/vision_probe.py --dual 验证）
LLM_DUAL_IMAGE=true
# 全局最大并发请求数（配合 asyncio.Semaphore 限流）
LLM_CONCURRENCY=5
# 单次请求超时（秒）
LLM_TIMEOUT=120
# 单次回复 Token 上限。推理型模型会把思考过程计入该额度，取值过小会导致正文被截断
LLM_MAX_TOKENS=2048
# 失败重试次数（指数退避 + 抖动）
LLM_MAX_RETRIES=4
TEMPERATURE=0.0

# ---------- 图片预处理 ----------
# 长边上限（像素）。Excel 内嵌截图常为超长图，降采样可显著降低 Token 与超限风险
IMAGE_MAX_SIDE=2048
IMAGE_MAX_BYTES=1500000

# ---------- 调试开关 ----------
# true 时不调用真实模型，返回构造结论，用于打通全链路 / 前端联调 / 压测
MOCK_LLM=false

# ---------- 前端 ----------
# 前端开发服务器端口（仅一键启动脚本使用）
FRONTEND_PORT=5173
